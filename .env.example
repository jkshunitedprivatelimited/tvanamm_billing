# ---------------------------------------------------------------------------
# Browser-safe configuration (exposed to the client bundle).
# Never place secret keys in NEXT_PUBLIC_* variables.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ADMIN_WEB_URL=http://localhost:3000
NEXT_PUBLIC_POS_WEB_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Server-only configuration. Loaded by Next.js server code and CLI tools.
# ---------------------------------------------------------------------------
NODE_ENV=development

# Supabase project. New-style keys (sb_publishable_... / sb_secret_...) are
# preferred; legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY still work.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Runtime queries via the transaction-mode pooler (port 6543, pgbouncer=true).
DATABASE_URL=postgresql://user:pass@host:6543/postgres?pgbouncer=true

# Migrations and integration tests via the session-mode pooler / direct (5432).
DIRECT_URL=postgresql://user:pass@host:5432/postgres

# Cross-origin allow list for server Route Handlers.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# >= 32 chars. Signs terminal credentials and workstation context tokens,
# and is the pepper for deterministic PIN lookup hashes.
IDENTITY_TOKEN_SECRET=dev-only-change-me-min-32-characters-long

# Admin login OTP over MSG91. Two supported paths:
#
# A) OTP Widget (client send/verify, server confirms the access token):
#    set MSG91_WIDGET_ID + NEXT_PUBLIC_MSG91_WIDGET_ID to the widget id and
#    MSG91_WIDGET_TOKEN + NEXT_PUBLIC_MSG91_WIDGET_TOKEN to its tokenAuth
#    (tokenAuth is a public client value by design). MSG91_AUTHKEY is the
#    server-only account key used by /api/v1/auth/msg91-verify.
#
# B) Supabase "Send SMS" hook (Supabase generates the OTP, we deliver it):
#    set MSG91_SMS_TEMPLATE_ID + MSG91_SENDER_ID and, in the Supabase
#    dashboard (Auth > Hooks > Send SMS), point the hook at
#    {NEXT_PUBLIC_ADMIN_WEB_URL}/api/v1/auth/send-sms and copy its secret
#    into SUPABASE_SEND_SMS_HOOK_SECRET.
#
# Either path is used only when ALLOW_INSECURE_DEV_AUTH is not true.
MSG91_AUTHKEY=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_WIDGET_TOKEN=
MSG91_SMS_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_OTP_VAR=otp
SUPABASE_SEND_SMS_HOOK_SECRET=

# TEMPORARY local-only admin login bypass (until MSG91 + Supabase Phone Auth).
# Requires ALL THREE: NODE_ENV=development, ALLOW_INSECURE_DEV_AUTH=true, and a
# non-empty ADMIN_DEV_OTP. The server refuses to start the bypass if the admin
# base URL is not loopback. Leave these blank; set locally only.
#   ALLOW_INSECURE_DEV_AUTH=true
#   ADMIN_DEV_OTP=123456
ALLOW_INSECURE_DEV_AUTH=
ADMIN_DEV_OTP=

# Optional: `npm run db:seed` creates these as ready-to-use OTP login accounts
# (Central Admin / Franchise Owner for the demo outlet). Dev only.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_OWNER_PHONE=

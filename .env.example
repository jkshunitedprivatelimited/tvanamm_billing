# ---------------------------------------------------------------------------
# Browser-safe configuration (exposed to the client bundle).
# Never place secret keys in NEXT_PUBLIC_* variables.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ADMIN_WEB_URL=http://localhost:3000
NEXT_PUBLIC_POS_WEB_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Server-only configuration. Loaded by Next.js server code and CLI tools.
# ---------------------------------------------------------------------------
NODE_ENV=development

# Supabase project. New-style keys (sb_publishable_... / sb_secret_...) are
# preferred; legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY still work.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Runtime queries via the transaction-mode pooler (port 6543, pgbouncer=true).
DATABASE_URL=postgresql://user:pass@host:6543/postgres?pgbouncer=true

# Migrations and integration tests via the session-mode pooler / direct (5432).
DIRECT_URL=postgresql://user:pass@host:5432/postgres

# Cross-origin allow list for server Route Handlers.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# >= 32 chars. Signs terminal credentials and workstation context tokens,
# and is the pepper for deterministic PIN lookup hashes.
IDENTITY_TOKEN_SECRET=dev-only-change-me-min-32-characters-long

# Admin login is Supabase Auth phone OTP. Supabase generates and verifies the
# code; MSG91 only delivers the SMS via Supabase's "Send SMS" auth hook.
# Configure the hook URL + secret in the Supabase dashboard (Auth > Hooks) and
# point it at an endpoint that calls MSG91 with these credentials.
MSG91_AUTHKEY=
MSG91_SMS_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_OTP_VAR=otp

# Optional: `npm run db:seed` creates these as ready-to-use OTP login accounts
# (Central Admin / Franchise Owner for the demo outlet). Dev only.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_OWNER_PHONE=
